# Local development defaults — works out of the box with `docker compose up -d`.
# Copy to .env or just run `npm run dev` (Next.js loads .env.development automatically).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smashladder"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/smashladder"
DATABASE_URL_POOLED="postgresql://postgres:postgres@localhost:5432/smashladder"
AUTH_SECRET="dev-secret-do-not-use-in-production"

# OAuth app credentials for "Connect with start.gg" on the Settings page
# (verifies a player's own start.gg identity, replacing the old
# self-declared profile URL). Create an app at
# https://start.gg/admin/profile/developer and register the redirect URI
# https://<your-domain>/api/startgg/callback. If unset, the connect button
# will error — nothing else on the site depends on these.
STARTGG_OAUTH_CLIENT_ID="573"
STARTGG_OAUTH_CLIENT_SECRET="01ce25c041cca08812f3efab76bdeb2e778dcb3f780fc53dc72ee64a4c5d9fc3"
