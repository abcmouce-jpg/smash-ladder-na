// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) Prisma adapter standard models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Application models ---

enum UserRole {
  USER
  MOD
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum LobbyEntryStatus {
  WAITING
  PAIRED
  CANCELLED
  EXPIRED
}

enum PairingMethod {
  MANUAL
  AUTO
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum TournamentStatus {
  SIGNUPS
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  PENDING_REPORT
  REPORTED
  CONFIRMED
  DISPUTED
  CANCELLED
  EXPIRED
}

enum ConfirmationMethod {
  SELF_CONFIRMED
  AUTO_TIMEOUT
  ADMIN_RESOLVED
  CORRECTED
  MUTUALLY_RESOLVED
}

enum PostStatus {
  OPEN
  MATCHED
  CLOSED
  EXPIRED
}

// One-directional: A blocking B doesn't imply B blocked A. Matchmaking treats
// a block as mutual either way (neither side should get paired with someone
// who blocked them, whether or not they know about it), but only the blocker
// can see/manage their own block list.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model User {
  id                   String     @id @default(cuid())
  discordId            String     @unique
  username             String
  avatarUrl            String?
  email                String?    @unique
  rating               Int        @default(1500)
  gamesPlayed          Int        @default(0) // drives isProvisional + K-factor tier
  noShowCount          Int        @default(0)
  cancelCount          Int        @default(0)
  misconductScore      Int        @default(0) // bumped only when a mod actions a ConductReport, not on filing
  suspendedUntil       DateTime? // set only for a timed SUSPENDED; null means indefinite (or n/a if not suspended). Past-due is lazily lifted back to ACTIVE on next access.
  lastKnownIp          String? // captured from x-forwarded-for at sign-in — lets a mod banning an account also ban the IP it was last seen using (see BannedIp)
  mainCharacter        String? // self-declared; drives the character leaderboard filter
  region               String? // self-declared match region; drives distance-based matchmaking
  maxMatchDistanceKm   Int?       @default(5000) // self-declared match radius; null means worldwide. Matching requires BOTH sides' radius to cover the actual distance.
  maxRatingGap         Int? // self-declared rating-gap tolerance; null means any rating (the default, to not shrink an already-small pool). Matching requires BOTH sides' gap to cover the actual difference.
  rematchCooldownHours Int? // self-declared minimum time before rematching the same opponent; null means anytime (the default). Matching requires BOTH sides' cooldown to have elapsed since their last match.
  wiredConnection      Boolean    @default(false) // self-declared LAN vs wireless, shown on profile like Smashmate's LAN badge
  requireWiredOpponent Boolean    @default(false) // if set, only match with opponents who have wiredConnection on. Checked per-side against the OTHER side's actual wiredConnection fact — not symmetric like distance/rating gap, since this is a claim about the other person, not a shared value.
  arenaPassword        String? // self-declared in-game room password override; null means use the ladder-wide default (see DEFAULT_ARENA_PASSWORD in lib/arena.ts). Lets streamers keep theirs off a publicly-documented value.
  startggUserId        String?    @unique // start.gg's own user id — set only via OAuth (user.identity scope) in lib/startgg-oauth.ts, replacing the old self-declared URL so a profile can't be claimed by someone else
  startggSlug          String? // e.g. "user/abc123" — builds the profile link (https://start.gg/{slug})
  startggGamerTag      String? // display tag from start.gg's player object, if the account has one
  startggConnectedAt   DateTime?
  role                 UserRole   @default(USER)
  status               UserStatus @default(ACTIVE)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  accounts                  Account[]
  sessions                  Session[]
  freeBattlePosts           FreeBattlePost[]
  lobbyEntries              RatingLobbyEntry[]
  matchesAsP1               RatingMatch[]      @relation("Player1Matches")
  matchesAsP2               RatingMatch[]      @relation("Player2Matches")
  ratingHistory             RatingHistory[]
  matchComments             MatchComment[]
  reportsFiled              ConductReport[]    @relation("ReportsFiled")
  reportsReceived           ConductReport[]    @relation("ReportsReceived")
  seasonStandings           SeasonStanding[]
  tournamentsHosted         Tournament[]
  tournamentEntries         TournamentEntry[]
  blocksMade                Block[]            @relation("BlocksMade")
  blocksReceived            Block[]            @relation("BlocksReceived")
  connectionReportsFiled    ConnectionReport[] @relation("ConnectionReportsFiled")
  connectionReportsReceived ConnectionReport[] @relation("ConnectionReportsReceived")

  @@index([rating])
  @@index([mainCharacter])
  @@index([region])
}

model RatingLobbyEntry {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  status        LobbyEntryStatus  @default(WAITING)
  pairingMethod PairingMethod     @default(MANUAL)
  pairedEntryId String?           @unique
  pairedEntry   RatingLobbyEntry? @relation("EntryPairing", fields: [pairedEntryId], references: [id])
  pairedByEntry RatingLobbyEntry? @relation("EntryPairing")
  matchId       String?           @unique
  match         RatingMatch?      @relation(fields: [matchId], references: [id])
  joinedAt      DateTime          @default(now())
  expiresAt     DateTime
  cancelledAt   DateTime?

  @@index([status, expiresAt])
  @@index([userId, joinedAt])
}

model RatingMatch {
  id                           String              @id @default(cuid())
  player1Id                    String
  player1                      User                @relation("Player1Matches", fields: [player1Id], references: [id])
  player2Id                    String
  player2                      User                @relation("Player2Matches", fields: [player2Id], references: [id])
  pairingMethod                PairingMethod       @default(MANUAL)
  roomCode                     String? // never rendered outside the paired pair's own view
  roomCodeSetById              String? // whoever entered it owns it; the other side can only read it
  status                       MatchStatus         @default(PENDING_REPORT)
  reportedWinnerId             String?
  reportedById                 String?
  reportedAt                   DateTime?
  secondReportWinnerId         String?
  secondReportById             String?
  secondReportAt               DateTime?
  confirmedAt                  DateTime?
  confirmationMethod           ConfirmationMethod?
  disputeReason                String?
  player1RatingBefore          Int?
  player1RatingAfter           Int?
  player2RatingBefore          Int?
  player2RatingAfter           Int?
  // Post-confirmation result correction — same matching-reports-auto-apply
  // idea as the original report/secondReport pair above, just usable after
  // CONFIRMED instead of only before it. Only ever eligible while this is
  // still each player's most recent CONFIRMED match (see requestResultCorrection),
  // so reversing and reapplying Elo here can never disturb a later match that
  // already used the ratings this one produced. A disagreement between the
  // two sides' corrections sets correctionDisputed for a mod to resolve.
  correctionWinnerId           String?
  correctionReportedById       String?
  correctionReportedAt         DateTime?
  correctionSecondWinnerId     String?
  correctionSecondReportedById String?
  correctionSecondReportedAt   DateTime?
  correctionDisputed           Boolean             @default(false)
  createdAt                    DateTime            @default(now())
  expiresAt                    DateTime // no-show / no-report cutoff
  seasonId                     String?
  season                       Season?             @relation(fields: [seasonId], references: [id])

  ratingHistory     RatingHistory[]
  lobbyEntry        RatingLobbyEntry?
  comments          MatchComment[]
  games             MatchGame[] // best-of-5: game 1 decides the stage via strike+pick, games 2-5 are counterpicks
  conductReports    ConductReport[]
  connectionReports ConnectionReport[]

  @@index([status])
  @@index([player1Id])
  @@index([player2Id])
  @@index([player1Id, status, confirmedAt])
  @@index([player2Id, status, confirmedAt])
}

// One game within a RatingMatch's best-of-5 set. Stage selection is
// strike-then-pick: actorA strikes actorAStrikes stages, actorB strikes
// actorBStrikes, then whichever of the two struck fewer stages picks the
// final stage from what's left (game 1: actorA struck 1 vs actorB's 2, so
// actorA picks; games 2-5: the previous game's winner strikes 2 and the
// loser, who struck 0, picks).
model MatchGame {
  id              String      @id @default(cuid())
  matchId         String
  match           RatingMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameNumber      Int
  actorAId        String
  actorAStrikes   Int
  actorACharacter String? // game 1: blind pick, hidden until both are in. Games 2-5: actorA (previous winner) must lock in first.
  actorBId        String
  actorBStrikes   Int
  actorBCharacter String?
  stagesRemaining String[]    @default([])
  struckStages    String[]    @default([])
  finalStage      String?
  turnStartedAt   DateTime    @default(now()) // reset on every strike/pick; a stale turn past STRIKE_TIMEOUT_MS auto-resolves with a random remaining stage

  reportedWinnerId     String?
  reportedById         String?
  reportedAt           DateTime?
  secondReportWinnerId String?
  secondReportById     String?
  secondReportAt       DateTime?
  winnerId             String?

  // Self-service re-agreement after a dispute (reportedWinnerId !=
  // secondReportWinnerId) — see requestDisputeResolution. Only one slot
  // needed: the first voter's pick lands here, and the second voter's pick
  // is compared against it inline rather than stored, since a match either
  // resolves the game immediately or resets both back to null to retry.
  disputeResolutionWinnerId String?
  disputeResolutionById     String?
  disputeResolutionAt       DateTime?

  createdAt DateTime @default(now())

  @@unique([matchId, gameNumber])
  @@index([matchId])
}

model MatchComment {
  id        String      @id @default(cuid())
  matchId   String
  match     RatingMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime    @default(now())

  @@index([matchId, createdAt])
}

model ConductReport {
  id             String       @id @default(cuid())
  matchId        String?
  match          RatingMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  reporterId     String
  reporter       User         @relation("ReportsFiled", fields: [reporterId], references: [id])
  reportedUserId String
  reportedUser   User         @relation("ReportsReceived", fields: [reportedUserId], references: [id])
  reason         String
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())

  @@index([reportedUserId])
  @@index([status])
}

// A lighter-weight signal than ConductReport: connection quality isn't
// misconduct, so this doesn't feed a mod queue or touch UserStatus — it's
// just a visible count (like noShowCount/cancelCount) other players can
// weigh before matching someone who claims a wired connection. One per
// match per reporter — a single click, not a written complaint.
model ConnectionReport {
  id             String      @id @default(cuid())
  matchId        String
  match          RatingMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reporterId     String
  reporter       User        @relation("ConnectionReportsFiled", fields: [reporterId], references: [id])
  reportedUserId String
  reportedUser   User        @relation("ConnectionReportsReceived", fields: [reportedUserId], references: [id])
  createdAt      DateTime    @default(now())

  @@unique([matchId, reporterId])
  @@index([reportedUserId])
}

// Checked in auth.ts's signIn callback against the request's x-forwarded-for
// IP — a match blocks sign-in outright, before any account lookup. Separate
// from User.status (BANNED) since this targets the network, not an account:
// meant for blocking a banned player's attempt to sign up again from the
// same connection with a fresh Discord account.
model BannedIp {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

// endsAt null = the currently active season. Ending one snapshots standings
// into SeasonStanding and resets User.rating/gamesPlayed for the next season.
model Season {
  id       String    @id @default(cuid())
  name     String
  startsAt DateTime  @default(now())
  endsAt   DateTime?

  matches   RatingMatch[]
  standings SeasonStanding[]

  @@index([endsAt])
}

model SeasonStanding {
  id          String @id @default(cuid())
  seasonId    String
  season      Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId      String
  user        User   @relation(fields: [userId], references: [id])
  finalRating Int
  gamesPlayed Int
  rank        Int

  @@unique([seasonId, userId])
  @@index([seasonId, rank])
}

// Unrated — results here don't touch ladder Elo. The bracket itself (double
// elimination, by convention) runs on start.gg; this just tracks who's
// hosting, who from the ladder is in, and links out to the real bracket.
model Tournament {
  id          String           @id @default(cuid())
  name        String
  description String?
  startggUrl  String?
  hostId      String
  host        User             @relation(fields: [hostId], references: [id])
  status      TournamentStatus @default(SIGNUPS)
  createdAt   DateTime         @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  entries TournamentEntry[]

  @@index([status])
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  joinedAt     DateTime   @default(now())

  @@unique([tournamentId, userId])
}

model RatingHistory {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  matchId      String
  match        RatingMatch @relation(fields: [matchId], references: [id])
  ratingBefore Int
  ratingAfter  Int
  delta        Int
  createdAt    DateTime    @default(now())

  @@index([userId, createdAt])
}

model FreeBattlePost {
  id            String     @id @default(cuid())
  authorId      String
  author        User       @relation(fields: [authorId], references: [id])
  comment       String
  region        String?
  status        PostStatus @default(OPEN)
  matchedWithId String?
  createdAt     DateTime   @default(now())
  expiresAt     DateTime // 24h TTL, same lazy-read/external-cron finalizer as RatingMatch
  matchedAt     DateTime?

  @@index([status, createdAt])
  @@index([authorId])
}
